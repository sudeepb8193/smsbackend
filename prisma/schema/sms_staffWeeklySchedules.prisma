model sms_staffWeeklySchedules {
  id                 String    @id @default(uuid()) @db.Uuid
  staffId String @db.Uuid
  staff                    sms_staff @relation(fields: [staffId], references: [id])
  dayOfWeek                Int       @db.SmallInt
  isWorking                Boolean   @default(true)
  shiftTemplateId String? @db.Uuid
  shiftTemplate            sms_shiftTemplates? @relation(fields: [shiftTemplateId], references: [id])
  customStartTime          DateTime? @db.Time
  customEndTime            DateTime? @db.Time
  customBreakStartTime     DateTime? @db.Time
  customBreakEndTime       DateTime? @db.Time
  effectiveFrom            DateTime  @db.Date
  effectiveTo              DateTime? @db.Date
  createdById String? @db.Uuid
  createdBy                sms_users? @relation(fields: [createdById], references: [id])
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([staffId, dayOfWeek, effectiveFrom])
  @@index([staffId, isWorking])
  @@map("sms_staffWeeklySchedules")
}
