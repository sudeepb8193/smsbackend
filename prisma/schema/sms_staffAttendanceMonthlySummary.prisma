model sms_staffAttendanceMonthlySummary {
  id                 String    @id @default(uuid()) @db.Uuid
  staffId String @db.Uuid
  staff                  sms_staff @relation(fields: [staffId], references: [id])
  branchId String @db.Uuid
  branch                 sms_branches @relation(fields: [branchId], references: [id])
  summaryYear            Int      @db.SmallInt
  summaryMonth           Int      @db.SmallInt
  totalWorkingDays       Int      @default(0) @db.SmallInt
  totalPresentDays       Int      @default(0) @db.SmallInt
  totalAbsentDays        Int      @default(0) @db.SmallInt
  totalLateDays          Int      @default(0) @db.SmallInt
  totalHalfDays          Int      @default(0) @db.SmallInt
  totalLeaveDays         Int      @default(0) @db.SmallInt
  totalWorkedMinutes     Int      @default(0)
  totalOvertimeMinutes   Int      @default(0)
  isFinal                Boolean  @default(false)
  generatedAt            DateTime @default(now())

  @@unique([staffId, summaryYear, summaryMonth])
  @@index([branchId, summaryYear, summaryMonth])
  @@map("sms_staffAttendanceMonthlySummary")
}
