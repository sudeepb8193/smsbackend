model sms_staffEmergencyContacts {
  id                 String    @id @default(uuid()) @db.Uuid
  staffId String @db.Uuid
  staff         sms_staff @relation(fields: [staffId], references: [id])
  contactName   String   @db.VarChar(120)
  relationship  String?  @db.VarChar(60)
  phoneNumber   String   @db.VarChar(20)
  priority      sms_branchManagerAssignments_assignmentType @default(primary)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([staffId, priority])
  @@map("sms_staffEmergencyContacts")
}
