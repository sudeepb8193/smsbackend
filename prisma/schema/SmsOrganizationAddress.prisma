model SmsOrganizationAddress {
  id             Int             @id @default(autoincrement())
  organizationId Int
  organization   SmsOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addressType    String          @default("registered")
  addressLine1   String
  addressLine2   String?
  landmark       String?
  city           String
  state          String
  postalCode     String
  countryCode    String
  latitude       Float?
  longitude      Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("sms_organization_addresses")
  @@unique([organizationId, addressType])
}
