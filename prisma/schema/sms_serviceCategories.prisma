model sms_serviceCategories {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization        sms_organizations @relation(fields: [organizationId], references: [id])
  parentCategoryId String? @db.Uuid
  parent              sms_serviceCategories? @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children            sms_serviceCategories[] @relation("CategoryHierarchy")
  name                String   @db.VarChar(80)
  slug                String   @db.VarChar(90)
  description         String?  @db.VarChar(255)
  iconKey             String?  @db.VarChar(50)
  displayOrder        Int      @default(0) @db.SmallInt
  status              sms_activeInactive @default(active)
  createdById String? @db.Uuid
  createdBy           sms_users? @relation(fields: [createdById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  serviceCategoryBranchSettings sms_serviceCategoryBranchSettings[]
  serviceCategoryMedia         sms_serviceCategoryMedia[]
  services                     sms_services[]

  @@unique([organizationId, slug])
  @@index([parentCategoryId, displayOrder])
  @@map("sms_serviceCategories")
}
