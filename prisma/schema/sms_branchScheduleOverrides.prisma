model sms_branchScheduleOverrides {
  id                 String    @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid
  branch             sms_branches @relation(fields: [branchId], references: [id])
  overrideDate       DateTime  @db.Date
  isClosed           Boolean   @default(false)
  openTime           DateTime? @db.Time
  closeTime          DateTime? @db.Time
  reason             String?   @db.VarChar(255)
  createdById String? @db.Uuid
  createdBy          sms_users? @relation(fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([branchId, overrideDate])
  @@map("sms_branchScheduleOverrides")
}
