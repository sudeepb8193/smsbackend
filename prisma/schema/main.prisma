// Main Prisma schema configuration & global enums

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  BRANCH_MANAGER
  ACCOUNTANT
  FRONT_DESK
  SERVICE_STAFF
  INVENTORY_MANAGER
  MARKETING_MANAGER
  CUSTOMER
}

