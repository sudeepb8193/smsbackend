model sms_customerPackageUsageLogs {
  id                 String    @id @default(uuid()) @db.Uuid
  packagePurchaseId String @db.Uuid
  packagePurchase       sms_customerPackagePurchases @relation(fields: [packagePurchaseId], references: [id])
  serviceId String @db.Uuid
  service               sms_services @relation(fields: [serviceId], references: [id])
  appointmentId String? @db.Uuid   // FK -> sms_appointments.id (Module 18, not yet modeled)
  quantityUsed          Int       @default(1) @db.SmallInt
  isReversed            Boolean   @default(false)
  reversedAt            DateTime?
  recordedById String @db.Uuid
  recordedBy            sms_users @relation(fields: [recordedById], references: [id])
  usedAt                DateTime  @default(now())

  @@index([packagePurchaseId, serviceId])
  @@index([appointmentId])
  @@map("sms_customerPackageUsageLogs")
}
