model sms_serviceBranchAvailability {
  id                 String    @id @default(uuid()) @db.Uuid
  serviceId String @db.Uuid
  service        sms_services @relation(fields: [serviceId], references: [id])
  branchId String @db.Uuid
  branch         sms_branches @relation(fields: [branchId], references: [id])
  isAvailable    Boolean  @default(true)
  createdById String? @db.Uuid
  createdBy      sms_users? @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  @@unique([serviceId, branchId])
  @@map("sms_serviceBranchAvailability")
}
