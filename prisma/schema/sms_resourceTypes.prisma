model sms_resourceTypes {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization      sms_organizations @relation(fields: [organizationId], references: [id])
  name              String   @db.VarChar(100)
  category          sms_resourceTypes_category
  description       String?  @db.VarChar(255)
  iconKey           String?  @db.VarChar(50)
  status            sms_activeInactive @default(active)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  resources                    sms_resources[]
  serviceRequiredResources      sms_serviceRequiredResources[]

  @@unique([organizationId, name])
  @@index([category, status])
  @@map("sms_resourceTypes")
}
