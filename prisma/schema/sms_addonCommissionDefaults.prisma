model sms_addonCommissionDefaults {
  id                 String    @id @default(uuid()) @db.Uuid
  addonId String @db.Uuid    @unique
  addon                    sms_addons @relation(fields: [addonId], references: [id])
  isCommissionEligible     Boolean   @default(true)
  commissionType           sms_commission_type @default(percentage)
  commissionValue          Decimal   @default(0.00) @db.Decimal(10, 2)
  effectiveFrom            DateTime  @db.Date
  effectiveTo              DateTime? @db.Date
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("sms_addonCommissionDefaults")
}
