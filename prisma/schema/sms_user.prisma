model User {
  id               Int          @id @default(autoincrement())
  uuid             String       @unique @default(uuid())
  organizationId   Int          @default(1)
  displayName      String
  email            String?
  phoneCountryCode String?
  phoneNumber      String?
  passwordHash     String?
  profilePhotoUrl  String?
  inviteToken      String?
  inviteExpiresAt  DateTime?
  inviteAcceptedAt DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  role             Role         @default(FRONT_DESK)
  createdBy        Int?
  creator          User?        @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdUsers     User[]       @relation("UserCreatedBy")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  userBranches     UserBranch[]

  @@map("sms_users")
  @@unique([organizationId, email])
  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
  @@index([inviteToken])
  @@index([lastLoginAt])
}

model SmsBranch {
  id             Int          @id @default(autoincrement())
  uuid           String       @unique @default(uuid())
  organizationId Int          @default(1)
  name           String
  code           String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  userBranches   UserBranch[]

  @@map("sms_branches")
  @@index([organizationId])
}

model UserBranch {
  userId   Int
  branchId Int
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   SmsBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("sms_user_branches")
}
