model sms_organizationTaxProfiles {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization              sms_organizations @relation(fields: [organizationId], references: [id])
  taxIdentifierType         sms_organizationTaxProfiles_taxIdentifierType
  taxIdentifierNumber       String   @db.VarChar(40)
  registeredBusinessName    String   @db.VarChar(150)
  taxRegistrationDate       DateTime? @db.Date
  isTaxExempt               Boolean  @default(false)
  documentUrl               String?  @db.VarChar(500)
  verificationStatus        sms_organizationTaxProfiles_verificationStatus @default(pending)
  verificationNotes         String?  @db.VarChar(255)
  verifiedAt                DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([organizationId])
  @@index([verificationStatus])
  @@map("sms_organizationTaxProfiles")
}
