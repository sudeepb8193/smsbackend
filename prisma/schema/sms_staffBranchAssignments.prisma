model sms_staffBranchAssignments {
  id                 String    @id @default(uuid()) @db.Uuid
  staffId String @db.Uuid
  staff           sms_staff @relation(fields: [staffId], references: [id])
  branchId String @db.Uuid
  branch          sms_branches @relation(fields: [branchId], references: [id])
  assignmentType  sms_staffBranchAssignments_assignmentType @default(secondary)
  effectiveFrom   DateTime  @db.Date
  effectiveTo     DateTime? @db.Date
  createdById String? @db.Uuid
  createdBy       sms_users? @relation(fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())

  @@unique([staffId, branchId, effectiveFrom])
  @@index([branchId, assignmentType])
  @@map("sms_staffBranchAssignments")
}
