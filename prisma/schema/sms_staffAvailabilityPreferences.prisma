model sms_staffAvailabilityPreferences {
  id                 String    @id @default(uuid()) @db.Uuid
  staffId String @db.Uuid
  staff             sms_staff @relation(fields: [staffId], references: [id])
  dayOfWeek         Int?      @db.SmallInt
  startTime         DateTime? @db.Time
  endTime           DateTime? @db.Time
  preferenceType    sms_staffAvailabilityPreferences_preferenceType
  note              String?   @db.VarChar(255)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([staffId, dayOfWeek])
  @@map("sms_staffAvailabilityPreferences")
}
