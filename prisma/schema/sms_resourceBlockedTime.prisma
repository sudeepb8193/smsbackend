model sms_resourceBlockedTime {
  id                 String    @id @default(uuid()) @db.Uuid
  resourceId String @db.Uuid
  resource             sms_resources @relation(fields: [resourceId], references: [id])
  branchId String @db.Uuid
  branch               sms_branches @relation(fields: [branchId], references: [id])
  blockDate            DateTime  @db.Date
  startTime            DateTime  @db.Time
  endTime              DateTime  @db.Time
  reasonCategory       sms_staffBlockedTime_reasonCategory @default(other)
  note                 String?   @db.VarChar(255)
  isRecurring          Boolean   @default(false)
  recurrenceEndDate    DateTime? @db.Date
  createdById String @db.Uuid
  createdBy            sms_users @relation(fields: [createdById], references: [id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([resourceId, blockDate])
  @@index([branchId, blockDate])
  @@map("sms_resourceBlockedTime")
}
