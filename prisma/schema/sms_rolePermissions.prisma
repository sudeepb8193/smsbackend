model sms_rolePermissions {
  id                 String    @id @default(uuid()) @db.Uuid
  roleId String @db.Uuid
  role           sms_roles @relation(fields: [roleId], references: [id])
  permissionId String @db.Uuid
  permission     sms_permissions @relation(fields: [permissionId], references: [id])
  scope          sms_rolePermissions_scope @default(own_branch)
  grantedById String? @db.Uuid
  grantedBy      sms_users? @relation(fields: [grantedById], references: [id])
  grantedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("sms_rolePermissions")
}
