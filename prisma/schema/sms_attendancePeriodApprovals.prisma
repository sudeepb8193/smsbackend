model sms_attendancePeriodApprovals {
  id                 String    @id @default(uuid()) @db.Uuid
  staffId String @db.Uuid
  staff             sms_staff @relation(fields: [staffId], references: [id])
  branchId String @db.Uuid
  branch            sms_branches @relation(fields: [branchId], references: [id])
  periodStart       DateTime  @db.Date
  periodEnd         DateTime  @db.Date
  status            sms_attendancePeriodApprovals_status @default(pending)
  approvedById String? @db.Uuid
  approvedBy        sms_users? @relation("PeriodApprovedBy", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  reopenedReason    String?   @db.VarChar(255)
  reopenedById String? @db.Uuid
  reopenedBy        sms_users? @relation("PeriodReopenedBy", fields: [reopenedById], references: [id])
  reopenedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([staffId, periodStart, periodEnd])
  @@index([branchId, status])
  @@map("sms_attendancePeriodApprovals")
}
