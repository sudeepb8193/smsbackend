model sms_servicePackageBranchAvailability {
  id                 String    @id @default(uuid()) @db.Uuid
  packageId String @db.Uuid
  package        sms_servicePackages @relation(fields: [packageId], references: [id])
  branchId String @db.Uuid
  branch         sms_branches @relation(fields: [branchId], references: [id])
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([packageId, branchId])
  @@map("sms_servicePackageBranchAvailability")
}
