model sms_leaveBlackoutPeriods {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization                  sms_organizations @relation(fields: [organizationId], references: [id])
  branchId String? @db.Uuid
  branch                        sms_branches? @relation(fields: [branchId], references: [id])
  name                          String   @db.VarChar(120)
  startDate                     DateTime @db.Date
  endDate                       DateTime @db.Date
  restrictionType               sms_leaveBlackoutPeriods_restrictionType @default(block_all)
  maxPercentageStaffOnLeave     Decimal? @db.Decimal(5, 2)
  appliesToLeaveTypeIds         String?  @db.VarChar(255)
  reason                        String?  @db.VarChar(255)
  createdById String? @db.Uuid
  createdBy                     sms_users? @relation(fields: [createdById], references: [id])
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([organizationId, branchId, startDate, endDate])
  @@map("sms_leaveBlackoutPeriods")
}
