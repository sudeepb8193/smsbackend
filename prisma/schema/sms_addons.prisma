model sms_addons {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization              sms_organizations @relation(fields: [organizationId], references: [id])
  addonType                 sms_addons_addonType
  name                      String   @db.VarChar(150)
  slug                      String   @db.VarChar(160)
  description               String?  @db.VarChar(255)
  imageUrl                  String?  @db.VarChar(500)
  priceAmount               Decimal  @db.Decimal(10, 2)
  durationMinutes           Int?     @db.SmallInt
  linkedProductId String? @db.Uuid  // FK -> sms_products.id (Module 23, not yet modeled)
  onlineBookingEnabled      Boolean  @default(false)
  status                    sms_activeInactive @default(active)
  createdById String? @db.Uuid
  createdBy                 sms_users? @relation(fields: [createdById], references: [id])
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  deletedAt                 DateTime?

  addonServiceMappings      sms_addonServiceMappings[]
  addonBranchAvailability   sms_addonBranchAvailability[]
  addonCommissionDefaults   sms_addonCommissionDefaults?

  @@unique([organizationId, slug])
  @@index([addonType, status])
  @@map("sms_addons")
}
