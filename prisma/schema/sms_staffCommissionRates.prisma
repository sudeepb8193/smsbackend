model sms_staffCommissionRates {
  id                 String    @id @default(uuid()) @db.Uuid
  staffId String @db.Uuid
  staff                  sms_staff @relation(fields: [staffId], references: [id])
  serviceId String? @db.Uuid
  service                sms_services? @relation(fields: [serviceId], references: [id])
  isCommissionEligible   Boolean   @default(true)
  commissionType         sms_commission_type @default(percentage)
  commissionValue        Decimal   @default(0.00) @db.Decimal(10, 2)
  effectiveFrom          DateTime  @db.Date
  effectiveTo            DateTime? @db.Date
  createdById String? @db.Uuid
  createdBy              sms_users? @relation(fields: [createdById], references: [id])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([staffId, serviceId, effectiveFrom])
  @@map("sms_staffCommissionRates")
}
