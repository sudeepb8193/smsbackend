model sms_userPasswordResets {
  id                 String    @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user            sms_users @relation(fields: [userId], references: [id])
  resetToken      String   @unique @db.VarChar(100)
  deliveryMethod  sms_userPasswordResets_deliveryMethod
  requestedIp     String?  @db.VarChar(45)
  expiresAt       DateTime
  usedAt          DateTime?
  initiatedBy     sms_userPasswordResets_initiatedBy @default(self)
  createdAt       DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("sms_userPasswordResets")
}
