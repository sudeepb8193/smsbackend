model sms_addonBranchAvailability {
  id                 String    @id @default(uuid()) @db.Uuid
  addonId String @db.Uuid
  addon               sms_addons @relation(fields: [addonId], references: [id])
  branchId String @db.Uuid
  branch              sms_branches @relation(fields: [branchId], references: [id])
  isAvailable         Boolean  @default(true)
  autoSyncWithStock   Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@unique([addonId, branchId])
  @@map("sms_addonBranchAvailability")
}
