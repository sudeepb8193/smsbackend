model sms_userBranchAssignments {
  id                 String    @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user           sms_users @relation("UserBranchUser", fields: [userId], references: [id])
  branchId String @db.Uuid
  branch         sms_branches @relation(fields: [branchId], references: [id])
  isHomeBranch   Boolean   @default(false)
  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date
  assignedById String? @db.Uuid
  assignedBy     sms_users? @relation("UserBranchAssignedBy", fields: [assignedById], references: [id])
  createdAt      DateTime  @default(now())

  @@unique([userId, branchId, effectiveFrom])
  @@index([userId, isHomeBranch])
  @@map("sms_userBranchAssignments")
}
